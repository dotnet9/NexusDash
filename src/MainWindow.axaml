<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:NexusDash.ViewModels"
        xmlns:ctrl="using:NexusDash.Controls"
        xmlns:converters="using:NexusDash.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="680"
        x:Class="NexusDash.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NexusDash - 系统监控仪表盘"
        Background="#1e1e1e"
        Foreground="#ffffff"
        FontFamily="Segoe UI, Microsoft YaHei UI" Width="800" Height="680">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <Border Grid.Row="0"
            Background="#1a1a2e"
            BorderBrush="#007acc"
            BorderThickness="0,0,0,2"
            Padding="24,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
          <Border Width="48" Height="48" CornerRadius="8" Background="#007acc">
            <TextBlock Text="ND"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#ffffff"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="NexusDash"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#ffffff"
                       FontFamily="Segoe UI, Microsoft YaHei UI">
              <TextBlock.Effect>
                <DropShadowEffect Color="#007acc" OffsetX="0" OffsetY="0" BlurRadius="8" Opacity="0.5"/>
              </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="系统监控仪表盘"
                       FontSize="12"
                       Foreground="#4ec9b0"
                       FontWeight="SemiBold"
                       LetterSpacing="2"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
          <Button Content="⏸ 暂停"
                  Command="{Binding RaiseTogglePauseHandler}"
                  IsVisible="{Binding IsRunning}"
                  Background="#2d2d44"
                  Foreground="#4ec9b0"
                  BorderBrush="#4ec9b0"
                  BorderThickness="1"
                  Padding="16,8"
                  CornerRadius="6"
                  FontWeight="SemiBold"
                  FontSize="13">
            <Button.Styles>
              <Style Selector="Button:pointerover">
                <Setter Property="Background" Value="#3d3d5c"/>
                <Setter Property="BorderBrush" Value="#4ec9b0"/>
                <Setter Property="Cursor" Value="Hand"/>
              </Style>
              <Style Selector="Button:pressed">
                <Setter Property="Background" Value="#1d1d2c"/>
                <Setter Property="RenderTransform" Value="scale(0.98)"/>
              </Style>
            </Button.Styles>
          </Button>
          <Button Content="▶ 继续"
                  Command="{Binding RaiseTogglePauseHandler}"
                  IsVisible="{Binding !IsRunning}"
                  Background="#007acc"
                  Foreground="#ffffff"
                  BorderBrush="#00a3ff"
                  BorderThickness="1"
                  Padding="16,8"
                  CornerRadius="6"
                  FontWeight="SemiBold"
                  FontSize="13">
            <Button.Styles>
              <Style Selector="Button:pointerover">
                <Setter Property="Background" Value="#0096e8"/>
                <Setter Property="BorderBrush" Value="#00b3ff"/>
                <Setter Property="Cursor" Value="Hand"/>
              </Style>
              <Style Selector="Button:pressed">
                <Setter Property="Background" Value="#0064a8"/>
                <Setter Property="RenderTransform" Value="scale(0.98)"/>
              </Style>
            </Button.Styles>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="20" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
        <!-- CPU Section -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="#252526"
                BorderBrush="#3c3c3c"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,10,10"
                Padding="20">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="反应堆核心 (CPU)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#4ec9b0"
                       Margin="0,0,0,16"/>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
              <!-- CPU Core Visualization -->
              <ctrl:CpuCoreControl Grid.Column="0"
                                   CpuUsage="{Binding CpuUsage}"
                                   CoreSize="160"
                                   Width="180"
                                   Height="180"
                                   HorizontalAlignment="Left"/>

              <!-- CPU Details -->
              <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="核心数" FontSize="12" Foreground="#808080"/>
                <TextBlock Text="{Binding CpuCoreCount, StringFormat='{}{0} 核心'}"
                           FontSize="18"
                           Foreground="#ffffff"
                           Margin="0,4,0,12"/>

                <TextBlock Text="温度" FontSize="12" Foreground="#808080"/>
                <TextBlock Text="{Binding CpuTemperature, StringFormat='{}{0:F1}°C'}"
                           FontSize="18"
                           Foreground="#ffffff"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <!-- Memory Section -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="#252526"
                BorderBrush="#3c3c3c"
                BorderThickness="1"
                CornerRadius="4"
                Margin="10,0,0,10"
                Padding="20">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="护盾容量 (内存)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#4ec9b0"
                       Margin="0,0,0,16"/>

            <Grid Grid.Row="1" RowDefinitions="Auto Auto Auto">

              <!-- Memory Bar -->
              <Grid Height="56">
                <ProgressBar Value="{Binding MemoryUsage}"
                             Maximum="100"
                             Minimum="0"
                             Height="32"
                             Foreground="{Binding MemoryUsage, Converter={x:Static converters:UsageToColorConverter.Instance}}"
                             Background="#3c3c3c"
                             CornerRadius="6"/>
                <TextBlock Text="{Binding MemoryUsage, StringFormat='{}{0:F1} %'}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#ffffff"/>
              </Grid>

              <!-- Memory Details -->
              <Grid Grid.Row="1" Margin="0,16,0,0" ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="已用内存" FontSize="12" Foreground="#808080"/>
                  <TextBlock Text="{Binding MemoryUsedText}"
                             FontSize="18"
                             Foreground="#ffffff"
                             Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="总内存" FontSize="12" Foreground="#808080"/>
                  <TextBlock Text="{Binding MemoryTotalText}"
                             FontSize="18"
                             Foreground="#ffffff"
                             Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <!-- Disk Section -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="#252526"
                BorderBrush="#3c3c3c"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,10,10,0"
                Padding="20">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="存储阵列 (磁盘)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#4ec9b0"
                       Margin="0,0,0,16"/>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Disks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,12" RowDefinitions="Auto Auto Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Name}"
                                 FontSize="14"
                                 Foreground="#ffffff"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding UsagePercentage, StringFormat='{}{0:F1} %'}"
                                 FontSize="14"
                                 Foreground="#808080"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding UsedBytes, Converter={x:Static converters:BytesToTextConverter.Instance}, StringFormat='已用: {0}'}"
                                 FontSize="12"
                                 Foreground="#808080"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding TotalBytes, Converter={x:Static converters:BytesToTextConverter.Instance}, StringFormat='总计: {0}'}"
                                 FontSize="12"
                                 Foreground="#808080"/>
                    </Grid>

                    <ProgressBar Grid.Row="2"
                                 Height="15"
                                 Value="{Binding UsagePercentage}"
                                 Maximum="100"
                                 Minimum="0"
                                 Margin="0,4,0,0"
                                 Foreground="{Binding UsagePercentage, Converter={x:Static converters:UsageToColorConverter.Instance}}"
                                 Background="#3c3c3c"
                                 CornerRadius="6"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!-- Network Section -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="#252526"
                BorderBrush="#3c3c3c"
                BorderThickness="1"
                CornerRadius="4"
                Margin="10,10,0,0"
                Padding="20">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="通信阵列 (网络)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#4ec9b0"
                       Margin="0,0,0,16"/>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
              <!-- Upload -->
              <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                <TextBlock Grid.Column="0"
                           Text="▲"
                           FontSize="20"
                           Foreground="#4ec9b0"
                           Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="上传速度"
                           FontSize="14"
                           Foreground="#808080"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding NetworkUploadSpeedText}"
                           FontSize="16"
                           Foreground="#ffffff"
                           VerticalAlignment="Center"/>
              </Grid>

              <!-- Download -->
              <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                <TextBlock Grid.Column="0"
                           Text="▼"
                           FontSize="20"
                           Foreground="#007acc"
                           Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="下载速度"
                           FontSize="14"
                           Foreground="#808080"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding NetworkDownloadSpeedText}"
                           FontSize="16"
                           Foreground="#ffffff"
                           VerticalAlignment="Center"/>
              </Grid>

              <!-- Connections -->
              <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="◉"
                           FontSize="20"
                           Foreground="#d7ba7d"
                           Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="活动连接"
                           FontSize="14"
                           Foreground="#808080"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding NetworkConnections}"
                           FontSize="16"
                           Foreground="#ffffff"
                           VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>

    <!-- Status Bar -->
    <Border Grid.Row="2"
            Background="#007acc"
            Padding="20,8">
      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="#ffffff"
                 FontSize="12"/>
    </Border>
  </Grid>
</Window>
