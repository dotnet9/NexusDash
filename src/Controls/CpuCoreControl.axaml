<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="200"
             x:Class="NexusDash.Controls.CpuCoreControl"
             x:Name="Root">

    <Grid Width="{Binding ElementName=Root, Path=CoreSize}"
          Height="{Binding ElementName=Root, Path=CoreSize}">

        <!-- Outer glow effect -->
        <Ellipse Width="{Binding ElementName=Root, Path=CoreSize}"
                 Height="{Binding ElementName=Root, Path=CoreSize}"
                 Fill="Transparent"
                 Stroke="{Binding ElementName=Root, Path=GlowColor}"
                 StrokeThickness="2"
                 Opacity="0.3">
            <Ellipse.Effect>
                <BlurEffect Radius="15" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Main rotating core -->
        <Ellipse Width="{Binding ElementName=Root, Path=CoreSize}"
                 Height="{Binding ElementName=Root, Path=CoreSize}"
                 Fill="Transparent"
                 Stroke="{Binding ElementName=Root, Path=CoreColor}"
                 StrokeThickness="3">
            <Ellipse.Effect>
                <BlurEffect Radius="8" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Inner ring -->
        <Ellipse Width="{Binding ElementName=Root, Path=InnerRingSize}"
                 Height="{Binding ElementName=Root, Path=InnerRingSize}"
                 Fill="Transparent"
                 Stroke="{Binding ElementName=Root, Path=InnerRingColor}"
                 StrokeThickness="2"
                 StrokeDashArray="15,8" />

        <!-- Center info -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding ElementName=Root, Path=CpuUsage, StringFormat='{}{0:F1}'}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{Binding ElementName=Root, Path=TextColor}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="%"
                       FontSize="12"
                       Foreground="{Binding ElementName=Root, Path=TextColor}"
                       Opacity="0.7"
                       HorizontalAlignment="Center" />
            <TextBlock Text="CPU"
                       FontSize="11"
                       Foreground="{Binding ElementName=Root, Path=TextColor}"
                       Opacity="0.5"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Warning overlay -->
        <Border Background="#f14c4c"
                Opacity="{Binding ElementName=Root, Path=WarningOpacity}"
                CornerRadius="100"
                Width="{Binding ElementName=Root, Path=CoreSize}"
                Height="{Binding ElementName=Root, Path=CoreSize}"
                IsVisible="{Binding ElementName=Root, Path=IsWarning}">
            <Border.Effect>
                <BlurEffect Radius="25" />
            </Border.Effect>
        </Border>
    </Grid>
</UserControl>