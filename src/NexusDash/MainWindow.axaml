<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:atom="https://atomui.net"
        xmlns:ndc="https://nexusdash.net/controls"
        xmlns:vm="using:NexusDash.ViewModels"
        xmlns:converters="using:NexusDash.Converters"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="820"
        x:Class="NexusDash.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="820"
        MinWidth="1060"
        MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="40"
                  Height="40"
                  CornerRadius="8"
                  Background="{DynamicResource AccentBrush}">
            <TextBlock Text="ND"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontWeight="SemiBold"
                       FontSize="15" />
          </Border>
          <StackPanel Spacing="1">
            <TextBlock Text="{Binding AppNameText}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding AppSubtitleText}"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
        </StackPanel>

        <TextBox Grid.Column="1"
                 Height="36"
                 VerticalAlignment="Center"
                 PlaceholderText="{Binding SearchPlaceholderText}"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 FontSize="13" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <atom:Button Content="{Binding PauseResumeText}"
                       Command="{Binding TogglePause}" />
          <atom:Button Content="{Binding EndProcessText}"
                       Command="{Binding EndSelectedProcesses}"
                       IsEnabled="{Binding HasSelectedProcesses}" />
          <atom:Button Content="{Binding EndProcessTreeText}"
                       Command="{Binding EndSelectedProcessTrees}"
                       IsEnabled="{Binding HasSelectedProcesses}" />
          <atom:Button Content="{Binding DarkThemeText}"
                       Command="{Binding SetDarkTheme}" />
          <atom:Button Content="{Binding LightThemeText}"
                       Command="{Binding SetLightTheme}" />
          <ComboBox Width="150"
                    ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LanguageOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Margin="16,14,16,0"
          ColumnDefinitions="*,*,*,*"
          ColumnSpacing="12">
      <Border Grid.Column="0"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding CpuText}" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding CpuUsageText}" FontWeight="SemiBold" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="54"
                                      Margin="0,10"
                                      Values="{Binding CpuHistory}"
                                      Stroke="{DynamicResource AccentBrush}" />
          <atom:ProgressBar Grid.Row="2"
                            Value="{Binding CpuUsage}"
                            Minimum="0"
                            Maximum="100"
                            IsProgressInfoVisible="False" />
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding MemoryText}" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding MemoryUsageText}" FontWeight="SemiBold" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="54"
                                      Margin="0,10"
                                      Values="{Binding MemoryHistory}"
                                      Stroke="{DynamicResource SuccessBrush}" />
          <TextBlock Grid.Row="2"
                     Text="{Binding MemorySummaryText}"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding DiskText}" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding DiskSpeedText}" FontWeight="SemiBold" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="54"
                                      Margin="0,10"
                                      Values="{Binding DiskHistory}"
                                      Stroke="{DynamicResource WarningBrush}" />
          <TextBlock Grid.Row="2"
                     Text="{Binding TreemapText}"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>
      </Border>

      <Border Grid.Column="3"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding NetworkText}" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding NetworkSpeedText}" FontWeight="SemiBold" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="54"
                                      Margin="0,10"
                                      Values="{Binding NetworkHistory}"
                                      Stroke="{DynamicResource DangerBrush}" />
          <TextBlock Grid.Row="2"
                     Text="{Binding SelectedCountText}"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2"
          Margin="16,14,16,12"
          ColumnDefinitions="2*,*"
          ColumnSpacing="12">
      <Grid Grid.Column="0" RowDefinitions="*,220" RowSpacing="12">
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,12,14,8">
              <TextBlock Text="{Binding ProcessTreeText}"
                         FontSize="16"
                         FontWeight="SemiBold" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ProcessCountText}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource PanelAltBackgroundBrush}"
                    Padding="12,8">
              <Grid ColumnDefinitions="80,90,*,80,110,110,100,80"
                    ColumnSpacing="8">
                <TextBlock Text="{Binding PidText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding ParentPidText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding ProcessNameText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding CpuText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="4" Text="{Binding MemoryText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="5" Text="{Binding DiskText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="6" Text="{Binding NetworkColumnText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="7" Text="{Binding GpuText}" Foreground="{DynamicResource SecondaryTextBrush}" />
              </Grid>
            </Border>

            <ListBox x:Name="ProcessList"
                     Grid.Row="2"
                     ItemsSource="{Binding VisibleProcesses}"
                     SelectionMode="Multiple"
                     SelectionChanged="ProcessList_SelectionChanged"
                     Background="Transparent">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="30" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProcessRowViewModel">
                  <Border Padding="12,5">
                    <Grid ColumnDefinitions="80,90,*,80,110,110,100,80"
                          ColumnSpacing="8">
                      <TextBlock Text="{Binding Pid}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding ParentPidText}"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <Grid Grid.Column="2"
                            ColumnDefinitions="Auto,24,*"
                            Margin="{Binding Depth, Converter={x:Static converters:DepthToMarginConverter.Instance}}">
                        <ToggleButton Grid.Column="1"
                                      Width="22"
                                      Height="22"
                                      Padding="0"
                                      Content="{Binding ExpanderGlyph}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      IsVisible="{Binding HasChildren}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <TextBlock Grid.Column="3" Text="{Binding CpuText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding MemoryText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding DiskText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="6" Text="{Binding NetworkText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="7" Text="{Binding GpuText}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Text="{Binding TreemapText}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <ndc:ProcessTreemapControl Grid.Row="1"
                                       Items="{Binding TreemapProcesses}" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="1"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <TabControl>
          <TabItem Header="{Binding DetailsText}">
            <Grid Margin="14">
              <TextBlock Text="{Binding NoProcessSelectedText}"
                         IsVisible="{Binding !HasSelectedProcess}"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

              <Grid IsVisible="{Binding HasSelectedProcess}"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
                    RowSpacing="10">
                <TextBlock Text="{Binding SelectedProcess.Name}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <Grid Grid.Row="1" ColumnDefinitions="120,*">
                  <TextBlock Text="{Binding PidText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedProcess.Pid}" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="120,*">
                  <TextBlock Text="{Binding StartTimeText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedProcess.StartTimeText}" TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="120,*">
                  <TextBlock Text="{Binding CpuText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedProcess.CpuText}" />
                </Grid>
                <Grid Grid.Row="4" ColumnDefinitions="120,*">
                  <TextBlock Text="{Binding MemoryText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedProcess.MemoryText}" />
                </Grid>
                <Grid Grid.Row="5" ColumnDefinitions="120,*">
                  <TextBlock Text="{Binding PathText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding SelectedProcess.ExecutablePath}"
                             TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="6" RowDefinitions="Auto,*">
                  <TextBlock Text="{Binding CommandLineText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             Margin="0,0,0,6" />
                  <TextBox Grid.Row="1"
                           Text="{Binding SelectedProcess.CommandLine}"
                           IsReadOnly="True"
                           AcceptsReturn="True"
                           TextWrapping="Wrap" />
                </Grid>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="{Binding HandlesText}">
            <Grid Margin="14" RowDefinitions="Auto,*" RowSpacing="12">
              <TextBox PlaceholderText="{Binding HandlesSearchPlaceholderText}" />
              <TextBlock Grid.Row="1"
                         Text="{Binding HandlesUnavailableText}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>
          </TabItem>

          <TabItem Header="{Binding NetworkText}">
            <TextBlock Margin="14"
                       Text="{Binding NetworkUnavailableText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </TabItem>

          <TabItem Header="{Binding ServicesText}">
            <TextBlock Margin="14"
                       Text="{Binding ServicesUnavailableText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </TabItem>

          <TabItem Header="{Binding StartupText}">
            <TextBlock Margin="14"
                       Text="{Binding StartupUnavailableText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <Border Grid.Row="3"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBlock Grid.Column="1" Text="{Binding SelectedCountText}" Foreground="{DynamicResource SecondaryTextBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
