<atom:Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:atom="https://atomui.net"
        xmlns:antdicons="https://atomui.net/icons/antdesign"
        xmlns:ndc="https://nexusdash.net/controls"
        xmlns:models="using:NexusDash.Models"
        xmlns:views="using:NexusDash.Views"
        xmlns:vm="using:NexusDash.ViewModels"
        xmlns:converters="using:NexusDash.Converters"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="820"
        x:Class="NexusDash.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="820"
        MinWidth="1060"
        MinHeight="680"
        Icon="/Assets/logo.ico"
        TitleBarFrameBackground="{DynamicResource PanelBackgroundBrush}"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <atom:Window.Logo>
    <Image Source="/Assets/logo.png" />
  </atom:Window.Logo>

  <atom:Window.Styles>
    <Style Selector="Border.panel">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="0 8 22 0 #14000000" />
    </Style>
    <Style Selector="Border.metricBadge">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    </Style>
    <Style Selector="atom|TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="atom|TextBlock.columnHeader">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="atom|TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="atom|TextBlock.metricHint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.dialogMask">
      <Setter Property="Background" Value="#99000000" />
    </Style>
    <Style Selector="Border.dialogCard">
      <Setter Property="Width" Value="520" />
      <Setter Property="MaxWidth" Value="520" />
      <Setter Property="MinHeight" Value="236" />
      <Setter Property="Padding" Value="22" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 22 48 0 #66000000" />
    </Style>
    <Style Selector="Border.dialogIcon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="antdicons|AppstoreOutlined.processCategoryIcon,
                     antdicons|CloudServerOutlined.processCategoryIcon,
                     antdicons|WindowsOutlined.processCategoryIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeBrush" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
  </atom:Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0"
          Margin="16,16,16,0"
          ColumnDefinitions="*,*,*,*"
          ColumnSpacing="12">
      <Border Grid.Column="0"
              Classes="panel"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <atom:TextBlock Text="{Binding CpuText}" Foreground="{DynamicResource SecondaryTextBrush}" />
            <atom:TextBlock Grid.Column="1" Text="{Binding CpuUsageText}" FontWeight="SemiBold" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="54"
                                      Margin="0,10"
                                      Values="{Binding CpuHistory}"
                                      Stroke="{DynamicResource AccentBrush}" />
          <atom:ProgressBar Grid.Row="2"
                            Value="{Binding CpuUsage}"
                            Minimum="0"
                            Maximum="100"
                            IsProgressInfoVisible="False" />
          <atom:TextBlock Grid.Row="3"
                          Classes="metricHint"
                          Text="{Binding TopCpuProcessText}"
                          Foreground="{Binding ProcessRowSecondaryTextBrush}"
                          Margin="0,8,0,0" />
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Classes="panel"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <atom:TextBlock Text="{Binding MemoryText}" Foreground="{DynamicResource SecondaryTextBrush}" />
            <atom:TextBlock Grid.Column="1" Text="{Binding MemoryUsageText}" FontWeight="SemiBold" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="54"
                                      Margin="0,10"
                                      Values="{Binding MemoryHistory}"
                                      Stroke="{DynamicResource SuccessBrush}" />
          <atom:TextBlock Grid.Row="2"
                     Text="{Binding MemorySummaryText}"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <atom:TextBlock Grid.Row="3"
                          Classes="metricHint"
                          Text="{Binding TopMemoryProcessText}"
                          Foreground="{Binding ProcessRowSecondaryTextBrush}"
                          Margin="0,6,0,0" />
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Classes="panel"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <atom:TextBlock Text="{Binding DiskText}" Foreground="{DynamicResource SecondaryTextBrush}" />
            <atom:TextBlock Grid.Column="1" Text="{Binding DiskSpeedText}" FontWeight="SemiBold" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="54"
                                      Margin="0,10"
                                      Values="{Binding DiskHistory}"
                                      Stroke="{DynamicResource WarningBrush}" />
          <atom:TextBlock Grid.Row="2"
                          Classes="metricHint"
                          Foreground="{Binding ProcessRowSecondaryTextBrush}"
                          Text="{Binding TopDiskProcessText}" />
        </Grid>
      </Border>

      <Border Grid.Column="3"
              Classes="panel"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <atom:TextBlock Text="{Binding NetworkText}" Foreground="{DynamicResource SecondaryTextBrush}" />
            <atom:TextBlock Grid.Column="1" Text="{Binding NetworkSpeedText}" FontWeight="SemiBold" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="54"
                                      Margin="0,10"
                                      Values="{Binding NetworkHistory}"
                                      Stroke="{DynamicResource DangerBrush}" />
          <atom:TextBlock Grid.Row="2"
                          Classes="metricHint"
                          Foreground="{Binding ProcessRowSecondaryTextBrush}"
                          Text="{Binding TopNetworkProcessText}" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="1"
          Margin="16,14,16,12"
          ColumnDefinitions="5*,2*"
          ColumnSpacing="12">
      <Grid Grid.Column="0" RowDefinitions="*,220" RowSpacing="12">
        <views:ProcessListView x:Name="ProcessListPane"
                               Grid.Row="0" />

        <Border Grid.Row="1"
                Classes="panel"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
          <Grid RowDefinitions="Auto,*">
            <atom:TextBlock Text="{Binding TreemapText}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <ndc:ProcessTreemapControl Grid.Row="1"
                                       Items="{Binding TreemapProcesses}" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="1"
              Classes="panel"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <atom:TabControl SizeType="Small">
          <atom:TabItem Header="{Binding DetailsText}">
            <Grid Margin="14">
              <atom:TextBlock Text="{Binding NoProcessSelectedText}"
                         IsVisible="{Binding !HasSelectedProcess}"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

              <Grid IsVisible="{Binding HasSelectedProcess}"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
                    RowSpacing="10">
                <atom:TextBlock Text="{Binding SelectedProcess.Name}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <Border Grid.Row="1"
                        IsVisible="{Binding HasSelectedProcessAccessLimit}"
                        Background="{DynamicResource PanelAltBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8">
                  <StackPanel Spacing="3">
                    <atom:TextBlock Text="{Binding AccessLimitedText}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontWeight="SemiBold" />
                    <atom:TextBlock Text="{Binding AccessLimitedDescriptionText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                  </StackPanel>
                </Border>
                <Grid Grid.Row="2" ColumnDefinitions="120,*">
                  <atom:TextBlock Text="{Binding PidText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <atom:TextBlock Grid.Column="1" Text="{Binding SelectedProcess.Pid}" />
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="120,*">
                  <atom:TextBlock Text="{Binding PublisherText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <atom:TextBlock Grid.Column="1" Text="{Binding SelectedProcess.PublisherText}" TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="4" ColumnDefinitions="120,*">
                  <atom:TextBlock Text="{Binding StartTimeText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <atom:TextBlock Grid.Column="1" Text="{Binding SelectedProcess.StartTimeText}" TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="5" ColumnDefinitions="120,*">
                  <atom:TextBlock Text="{Binding CpuText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <atom:TextBlock Grid.Column="1" Text="{Binding SelectedProcess.CpuText}" />
                </Grid>
                <Grid Grid.Row="6" ColumnDefinitions="120,*">
                  <atom:TextBlock Text="{Binding MemoryText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <atom:TextBlock Grid.Column="1" Text="{Binding SelectedProcess.MemoryText}" />
                </Grid>
                <Grid Grid.Row="7" ColumnDefinitions="120,*">
                  <atom:TextBlock Text="{Binding PathText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <atom:TextBlock Grid.Column="1"
                             Text="{Binding SelectedProcess.ExecutablePath}"
                             TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="8" RowDefinitions="Auto,*">
                  <atom:TextBlock Text="{Binding CommandLineText}"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             Margin="0,0,0,6" />
                  <atom:TextBox Grid.Row="1"
                                Text="{Binding SelectedProcess.CommandLine}"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap" />
                </Grid>
              </Grid>
            </Grid>
          </atom:TabItem>

          <atom:TabItem Header="{Binding HandlesText}">
            <Grid Margin="14" RowDefinitions="Auto,*" RowSpacing="12">
              <atom:TextBox PlaceholderText="{Binding HandlesSearchPlaceholderText}"
                            IsAllowClear="True" />
              <atom:TextBlock Grid.Row="1"
                         Text="{Binding HandlesUnavailableText}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>
          </atom:TabItem>

          <atom:TabItem Header="{Binding NetworkText}">
            <Grid Margin="14"
                  RowDefinitions="Auto,Auto,*"
                  RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">
                <StackPanel Spacing="3"
                            VerticalAlignment="Center">
                  <atom:TextBlock Classes="sectionTitle"
                             Text="{Binding ProcessNetworkConnectionsText}"
                             Foreground="{Binding ProcessRowPrimaryTextBrush}" />
                  <atom:TextBlock Classes="muted"
                             Text="{Binding SelectedProcessNetworkSummaryText}"
                             FontSize="12"
                             Foreground="{Binding ProcessRowSecondaryTextBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        Classes="metricBadge"
                        MinWidth="92">
                  <atom:TextBlock Text="{Binding SelectedProcessConnectionTotalText}"
                             FontWeight="SemiBold"
                             Foreground="{Binding ProcessRowPrimaryTextBrush}"
                             HorizontalAlignment="Center" />
                </Border>
              </Grid>

              <Grid Grid.Row="1"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="8">
                <Border Grid.Column="0"
                        Classes="metricBadge">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="8">
                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
                    <atom:TextBlock Grid.Column="1"
                               Text="{Binding SelectedProcessTcpConnectionCountText}"
                               Foreground="{Binding ProcessRowPrimaryTextBrush}"
                               FontWeight="SemiBold" />
                  </Grid>
                </Border>
                <Border Grid.Column="1"
                        Classes="metricBadge">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="8">
                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource SuccessBrush}"
                            VerticalAlignment="Center" />
                    <atom:TextBlock Grid.Column="1"
                               Text="{Binding SelectedProcessUdpConnectionCountText}"
                               Foreground="{Binding ProcessRowPrimaryTextBrush}"
                               FontWeight="SemiBold" />
                  </Grid>
                </Border>
              </Grid>

              <Grid Grid.Row="2">
                <atom:TextBlock Text="{Binding NetworkSelectProcessText}"
                           IsVisible="{Binding !HasSelectedProcess}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <atom:TextBlock Text="{Binding NetworkNoConnectionsText}"
                           IsVisible="{Binding HasSelectedProcessWithoutNetworkConnections}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <atom:DataGrid ItemsSource="{Binding SelectedProcessNetworkConnections}"
                               AutoGenerateColumns="False"
                               CanUserReorderColumns="True"
                               CanUserResizeColumns="True"
                               CanUserSortColumns="True"
                               IsReadOnly="True"
                               IsFrameBorderVisible="False"
                               IsVisible="{Binding HasSelectedProcessNetworkConnections}"
                               PaginationVisibility="None"
                               RowHeight="32"
                               ColumnHeaderHeight="32"
                               SizeType="Small"
                               GridLinesVisibility="Horizontal"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               Background="Transparent">
                  <atom:DataGrid.Columns>
                    <atom:DataGridTemplateColumn Header="{Binding ProtocolText}"
                                                 Width="72"
                                                 SortMemberPath="Protocol"
                                                 CanUserSort="True"
                                                 CanUserResize="True">
                      <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                          <atom:TextBlock Text="{Binding Protocol}"
                                          FontWeight="SemiBold"
                                          Foreground="{Binding $parent[Window].DataContext.ProcessRowPrimaryTextBrush}"
                                          VerticalAlignment="Center" />
                        </DataTemplate>
                      </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTemplateColumn Header="{Binding LocalEndpointText}"
                                                 Width="170"
                                                 SortMemberPath="LocalEndpointText"
                                                 CanUserSort="True"
                                                 CanUserResize="True">
                      <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                          <atom:TextBlock Text="{Binding LocalEndpointText}"
                                          TextTrimming="CharacterEllipsis"
                                          Foreground="{Binding $parent[Window].DataContext.ProcessRowPrimaryTextBrush}"
                                          VerticalAlignment="Center" />
                        </DataTemplate>
                      </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTemplateColumn Header="{Binding RemoteEndpointText}"
                                                 Width="170"
                                                 SortMemberPath="RemoteEndpointText"
                                                 CanUserSort="True"
                                                 CanUserResize="True">
                      <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                          <atom:TextBlock Text="{Binding RemoteEndpointText}"
                                          TextTrimming="CharacterEllipsis"
                                          Foreground="{Binding $parent[Window].DataContext.ProcessRowPrimaryTextBrush}"
                                          VerticalAlignment="Center" />
                        </DataTemplate>
                      </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTemplateColumn Header="{Binding StateText}"
                                                 Width="96"
                                                 SortMemberPath="State"
                                                 CanUserSort="True"
                                                 CanUserResize="True">
                      <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                          <atom:TextBlock Text="{Binding State}"
                                          TextTrimming="CharacterEllipsis"
                                          VerticalAlignment="Center"
                                          Foreground="{Binding $parent[Window].DataContext.ProcessRowSecondaryTextBrush}" />
                        </DataTemplate>
                      </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTemplateColumn Header="{Binding LastSeenText}"
                                                 Width="126"
                                                 SortMemberPath="Timestamp"
                                                 CanUserSort="True"
                                                 CanUserResize="True">
                      <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                          <atom:TextBlock Text="{Binding TimestampText}"
                                          TextTrimming="CharacterEllipsis"
                                          VerticalAlignment="Center"
                                          Foreground="{Binding $parent[Window].DataContext.ProcessRowSecondaryTextBrush}" />
                        </DataTemplate>
                      </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                  </atom:DataGrid.Columns>
                </atom:DataGrid>
              </Grid>
            </Grid>
          </atom:TabItem>

          <atom:TabItem Header="{Binding ServicesText}">
            <atom:TextBlock Margin="14"
                       Text="{Binding ServicesUnavailableText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </atom:TabItem>

          <atom:TabItem Header="{Binding StartupText}">
            <atom:TextBlock Margin="14"
                       Text="{Binding StartupUnavailableText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </atom:TabItem>
        </atom:TabControl>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
            ColumnSpacing="10">
        <atom:IconButton Width="26"
                         MinWidth="26"
                         MaxWidth="26"
                         Height="26"
                         MinHeight="26"
                         MaxHeight="26"
                         Padding="0"
                         IconWidth="16"
                         IconHeight="16"
                         Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}"
                         Click="SettingsButton_Click"
                         AutomationProperties.Name="{Binding SettingsText}"
                         ToolTip.Tip="{Binding SettingsText}" />
        <atom:IconButton Grid.Column="1"
                         Width="26"
                         MinWidth="26"
                         MaxWidth="26"
                         Height="26"
                         MinHeight="26"
                         MaxHeight="26"
                         Padding="0"
                         IconWidth="16"
                         IconHeight="16"
                         Icon="{antdicons:AntDesignIconProvider Kind=PauseCircleOutlined}"
                         Command="{Binding PauseRefresh}"
                         AutomationProperties.Name="{Binding PauseText}"
                         ToolTip.Tip="{Binding PauseText}"
                         IsVisible="{Binding IsRefreshRunning}" />
        <atom:IconButton Grid.Column="1"
                         Width="26"
                         MinWidth="26"
                         MaxWidth="26"
                         Height="26"
                         MinHeight="26"
                         MaxHeight="26"
                         Padding="0"
                         IconWidth="16"
                         IconHeight="16"
                         Icon="{antdicons:AntDesignIconProvider Kind=PlayCircleOutlined}"
                         Command="{Binding ResumeRefresh}"
                         AutomationProperties.Name="{Binding ResumeText}"
                         ToolTip.Tip="{Binding ResumeText}"
                         IsVisible="{Binding IsRefreshPaused}" />
        <atom:TextBlock Grid.Column="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center" />
        <atom:TextBlock Grid.Column="3"
                   Text="{Binding SelectedCountText}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.RowSpan="3"
            Classes="dialogMask"
            IsVisible="{Binding IsEndProcessConfirmationVisible}">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Classes="dialogCard"
              Width="520"
              MaxWidth="520"
              MinHeight="236"
              Padding="22"
              CornerRadius="8"
              Background="{Binding DialogSurfaceBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              BoxShadow="0 22 48 0 #66000000">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="18">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="12">
            <Border Classes="dialogIcon">
              <atom:TextBlock Text="!"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="17"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource WarningBrush}" />
            </Border>
            <atom:TextBlock Grid.Column="1"
                       Text="{Binding EndProcessConfirmationTitleText}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{Binding ProcessRowPrimaryTextBrush}"
                       VerticalAlignment="Center" />
          </Grid>
          <atom:TextBlock Grid.Row="1"
                     Text="{Binding EndProcessConfirmationMessageText}"
                     TextWrapping="Wrap"
                     Foreground="{Binding ProcessRowSecondaryTextBrush}" />
          <Border Grid.Row="2"
                  Background="{Binding DialogInsetBrush}"
                  BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,10"
                  MinHeight="76"
                  MaxHeight="132">
            <atom:TextBlock Text="{Binding EndProcessConfirmationProcessListText}"
                       TextWrapping="Wrap"
                       Foreground="{Binding ProcessRowPrimaryTextBrush}" />
          </Border>
          <StackPanel Grid.Row="3"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <atom:Button Content="{Binding CancelText}"
                         Command="{Binding CancelPendingProcessTermination}" />
            <atom:Button Content="{Binding ConfirmText}"
                         ButtonType="Primary"
                         IsDanger="True"
                         Command="{Binding ConfirmPendingProcessTermination}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</atom:Window>
