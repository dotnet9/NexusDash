<atom:Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:atom="https://atomui.net"
        xmlns:antdicons="https://atomui.net/icons/antdesign"
        xmlns:ndc="https://nexusdash.net/controls"
        xmlns:models="using:NexusDash.Models"
        xmlns:views="using:NexusDash.Views"
        xmlns:vm="using:NexusDash.ViewModels"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="760"
        x:Class="NexusDash.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Classes="mainShell"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.ico"
        TitleBarFrameBackground="{DynamicResource PanelBackgroundBrush}"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

  <atom:Window.Logo>
    <Image Source="/Assets/logo.png" />
  </atom:Window.Logo>

  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0"
          Margin="18,14,18,0"
          ColumnDefinitions="*,*,*,*"
          ColumnSpacing="10">
      <Border Grid.Column="0"
              Classes="panel metricPanel">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <atom:TextBlock Classes="metricLabel" Text="{Binding CpuText}" />
            <atom:TextBlock Grid.Column="1" Classes="metricValue" Text="{Binding CpuUsageText}" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="46"
                                      Margin="0,8"
                                      Values="{Binding CpuHistory}"
                                      Stroke="{DynamicResource AccentBrush}" />
          <atom:ProgressBar Grid.Row="2"
                            Value="{Binding CpuUsage}"
                            Minimum="0"
                            Maximum="100"
                            IsProgressInfoVisible="False" />
          <atom:TextBlock Grid.Row="3"
                          Classes="metricHint"
                          Text="{Binding TopCpuProcessText}"
                          Margin="0,8,0,0" />
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Classes="panel metricPanel">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <atom:TextBlock Classes="metricLabel" Text="{Binding MemoryText}" />
            <atom:TextBlock Grid.Column="1" Classes="metricValue" Text="{Binding MemoryUsageText}" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="46"
                                      Margin="0,8"
                                      Values="{Binding MemoryHistory}"
                                      Stroke="{DynamicResource SuccessBrush}" />
          <atom:TextBlock Grid.Row="2"
                     Text="{Binding MemorySummaryText}"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <atom:TextBlock Grid.Row="3"
                          Classes="metricHint"
                          Text="{Binding TopMemoryProcessText}"
                          Margin="0,6,0,0" />
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Classes="panel metricPanel">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <atom:TextBlock Classes="metricLabel" Text="{Binding DiskText}" />
            <atom:TextBlock Grid.Column="1" Classes="metricValue" Text="{Binding DiskSpeedText}" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="46"
                                      Margin="0,8"
                                      Values="{Binding DiskHistory}"
                                      Stroke="{DynamicResource WarningBrush}" />
          <atom:TextBlock Grid.Row="2"
                          Classes="metricHint"
                          Text="{Binding TopDiskProcessText}" />
        </Grid>
      </Border>

      <Border Grid.Column="3"
              Classes="panel metricPanel">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <atom:TextBlock Classes="metricLabel" Text="{Binding NetworkText}" />
            <atom:TextBlock Grid.Column="1" Classes="metricValue" Text="{Binding NetworkSpeedText}" />
          </Grid>
          <ndc:MetricSparklineControl Grid.Row="1"
                                      Height="46"
                                      Margin="0,8"
                                      Values="{Binding NetworkHistory}"
                                      Stroke="{DynamicResource DangerBrush}" />
          <atom:TextBlock Grid.Row="2"
                          Classes="metricHint"
                          Text="{Binding TopNetworkProcessText}" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="1"
          Margin="18,12,18,10"
          ColumnDefinitions="*,350"
          ColumnSpacing="12">
      <Grid Grid.Column="0" RowDefinitions="*,188" RowSpacing="12">
        <views:ProcessListView Grid.Row="0"
                               DataContext="{Binding ProcessList}" />

        <Border Grid.Row="1"
                Classes="panel"
                Padding="12">
          <Grid RowDefinitions="Auto,*">
            <atom:TextBlock Text="{Binding TreemapText}"
                       Classes="sectionTitle"
                       FontWeight="SemiBold"
                       Margin="2,0,0,10" />
            <ndc:ProcessTreemapControl Grid.Row="1"
                                       Items="{Binding TreemapProcesses}" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="1"
              Classes="panel">
        <atom:TabControl SizeType="Small">
          <atom:TabItem Header="{Binding DetailsText}">
            <Grid Margin="14">
              <atom:TextBlock Text="{Binding NoProcessSelectedText}"
                         IsVisible="{Binding !HasSelectedProcess}"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

              <ScrollViewer IsVisible="{Binding HasSelectedProcess}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="8">
                  <atom:TextBlock Text="{Binding SelectedProcess.Name}"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis" />
                  <Border Grid.Row="1"
                          IsVisible="{Binding HasSelectedProcessAccessLimit}"
                          Background="{DynamicResource PanelAltBackgroundBrush}"
                          BorderBrush="{DynamicResource WarningBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="10,8">
                    <StackPanel Spacing="3">
                      <atom:TextBlock Text="{Binding AccessLimitedText}"
                                      Foreground="{DynamicResource WarningBrush}"
                                      FontWeight="SemiBold" />
                      <atom:TextBlock Text="{Binding AccessLimitedDescriptionText}"
                                      TextWrapping="Wrap"
                                      Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                  </Border>
                  <Grid Grid.Row="2" ColumnDefinitions="104,*">
                    <atom:TextBlock Text="{Binding PidText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <atom:TextBlock Grid.Column="1" Text="{Binding SelectedProcess.Pid}" />
                  </Grid>
                  <Grid Grid.Row="3" ColumnDefinitions="104,*">
                    <atom:TextBlock Text="{Binding PublisherText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <atom:TextBlock Grid.Column="1" Text="{Binding SelectedProcess.PublisherText}" TextWrapping="Wrap" />
                  </Grid>
                  <Grid Grid.Row="4" ColumnDefinitions="104,*">
                    <atom:TextBlock Text="{Binding StartTimeText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <atom:TextBlock Grid.Column="1" Text="{Binding SelectedProcess.StartTimeText}" TextWrapping="Wrap" />
                  </Grid>
                  <Grid Grid.Row="5" ColumnDefinitions="104,*">
                    <atom:TextBlock Text="{Binding CpuText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <atom:TextBlock Grid.Column="1" Text="{Binding SelectedProcess.CpuText}" />
                  </Grid>
                  <Grid Grid.Row="6" ColumnDefinitions="104,*">
                    <atom:TextBlock Text="{Binding MemoryText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <atom:TextBlock Grid.Column="1" Text="{Binding SelectedProcess.MemoryText}" />
                  </Grid>
                  <Grid Grid.Row="7" ColumnDefinitions="104,*">
                    <atom:TextBlock Text="{Binding PathText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <atom:TextBlock Grid.Column="1"
                                    Text="{Binding SelectedProcess.ExecutablePath}"
                                    TextWrapping="Wrap" />
                  </Grid>
                  <Grid Grid.Row="8" RowDefinitions="Auto,Auto">
                    <atom:TextBlock Text="{Binding CommandLineText}"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Margin="0,4,0,6" />
                    <atom:TextBox Grid.Row="1"
                                  Height="132"
                                  Text="{Binding SelectedProcess.CommandLine}"
                                  IsReadOnly="True"
                                  AcceptsReturn="True"
                                  TextWrapping="Wrap" />
                  </Grid>
                </Grid>
              </ScrollViewer>
            </Grid>
          </atom:TabItem>

          <atom:TabItem Header="{Binding HandlesText}">
            <Grid Margin="14" RowDefinitions="Auto,*" RowSpacing="12">
              <atom:TextBox PlaceholderText="{Binding HandlesSearchPlaceholderText}"
                            IsAllowClear="True" />
              <atom:TextBlock Grid.Row="1"
                         Text="{Binding HandlesUnavailableText}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>
          </atom:TabItem>

          <atom:TabItem Header="{Binding NetworkText}">
            <Grid Margin="12"
                  RowDefinitions="Auto,Auto,*"
                  RowSpacing="12">
              <Grid ColumnDefinitions="*,92"
                    ColumnSpacing="8">
                <StackPanel Spacing="3"
                            VerticalAlignment="Center">
                  <atom:TextBlock Classes="sectionTitle"
                             Text="{Binding ProcessNetworkConnectionsText}"
                             Foreground="{DynamicResource PrimaryTextBrush}" />
                  <atom:TextBlock Classes="muted"
                             Text="{Binding SelectedProcessNetworkSummaryText}"
                             FontSize="11"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        Classes="metricBadge"
                        MinWidth="86">
                  <atom:TextBlock Text="{Binding SelectedProcessConnectionTotalText}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             HorizontalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </Border>
              </Grid>

              <Grid Grid.Row="1"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="8">
                <Border Grid.Column="0"
                        Classes="metricBadge">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="8">
                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
                    <atom:TextBlock Grid.Column="1"
                               Text="{Binding SelectedProcessTcpConnectionCountText}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
                <Border Grid.Column="1"
                        Classes="metricBadge">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="8">
                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource SuccessBrush}"
                            VerticalAlignment="Center" />
                    <atom:TextBlock Grid.Column="1"
                               Text="{Binding SelectedProcessUdpConnectionCountText}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </Grid>

              <Grid Grid.Row="2">
                <atom:TextBlock Text="{Binding NetworkSelectProcessText}"
                           IsVisible="{Binding !HasSelectedProcess}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <atom:TextBlock Text="{Binding NetworkNoConnectionsText}"
                           IsVisible="{Binding HasSelectedProcessWithoutNetworkConnections}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <atom:DataGrid x:Name="NetworkConnectionsGrid"
                               ItemsSource="{Binding SelectedProcessNetworkConnections}"
                               Classes="compactDataGrid"
                               AutoGenerateColumns="False"
                               CanUserReorderColumns="True"
                               CanUserResizeColumns="True"
                               CanUserSortColumns="True"
                               IsReadOnly="True"
                               IsFrameBorderVisible="False"
                               IsVisible="{Binding HasSelectedProcessNetworkConnections}"
                               PaginationVisibility="None"
                               GridLinesVisibility="Horizontal"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               PointerPressed="NetworkConnectionsGrid_PointerPressed"
                               Background="Transparent">
                  <atom:DataGrid.Columns>
                    <atom:DataGridTemplateColumn Header="{Binding ProtocolText}"
                                                 Width="72"
                                                 SortMemberPath="Protocol"
                                                 CanUserSort="True"
                                                 CanUserResize="True">
                      <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                          <atom:TextBlock Text="{Binding Protocol}"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          VerticalAlignment="Center" />
                        </DataTemplate>
                      </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTemplateColumn Header="{Binding LocalEndpointText}"
                                                 Width="150"
                                                 SortMemberPath="LocalEndpointText"
                                                 CanUserSort="True"
                                                 CanUserResize="True">
                      <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                          <atom:TextBlock Text="{Binding LocalEndpointText}"
                                          TextTrimming="CharacterEllipsis"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          VerticalAlignment="Center" />
                        </DataTemplate>
                      </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTemplateColumn Header="{Binding RemoteEndpointText}"
                                                 Width="150"
                                                 SortMemberPath="RemoteEndpointText"
                                                 CanUserSort="True"
                                                 CanUserResize="True">
                      <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                          <atom:TextBlock Text="{Binding RemoteEndpointText}"
                                          TextTrimming="CharacterEllipsis"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          VerticalAlignment="Center" />
                        </DataTemplate>
                      </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTemplateColumn Header="{Binding StateText}"
                                                 Width="92"
                                                 SortMemberPath="State"
                                                 CanUserSort="True"
                                                 CanUserResize="True">
                      <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                          <atom:TextBlock Text="{Binding State}"
                                          TextTrimming="CharacterEllipsis"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource SecondaryTextBrush}" />
                        </DataTemplate>
                      </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTemplateColumn Header="{Binding LastSeenText}"
                                                 Width="118"
                                                 SortMemberPath="Timestamp"
                                                 CanUserSort="True"
                                                 CanUserResize="True">
                      <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                          <atom:TextBlock Text="{Binding TimestampText}"
                                          TextTrimming="CharacterEllipsis"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource SecondaryTextBrush}" />
                        </DataTemplate>
                      </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                  </atom:DataGrid.Columns>
                </atom:DataGrid>
              </Grid>
            </Grid>
          </atom:TabItem>

          <atom:TabItem Header="{Binding ServicesText}">
            <atom:TextBlock Margin="14"
                       Text="{Binding ServicesUnavailableText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </atom:TabItem>

          <atom:TabItem Header="{Binding StartupText}">
            <atom:TextBlock Margin="14"
                       Text="{Binding StartupUnavailableText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </atom:TabItem>
        </atom:TabControl>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="18,7">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
            ColumnSpacing="10">
        <atom:IconButton Classes="statusBarButton"
                         Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}"
                         Command="{Binding OpenSettingsWindow}"
                         AutomationProperties.Name="{Binding SettingsText}"
                         ToolTip.Tip="{Binding SettingsText}" />
        <atom:IconButton Grid.Column="1"
                         Classes="statusBarButton"
                         Icon="{antdicons:AntDesignIconProvider Kind=PauseCircleOutlined}"
                         Command="{Binding PauseRefresh}"
                         AutomationProperties.Name="{Binding PauseText}"
                         ToolTip.Tip="{Binding PauseText}"
                         IsVisible="{Binding IsRefreshRunning}" />
        <atom:IconButton Grid.Column="1"
                         Classes="statusBarButton"
                         Icon="{antdicons:AntDesignIconProvider Kind=PlayCircleOutlined}"
                         Command="{Binding ResumeRefresh}"
                         AutomationProperties.Name="{Binding ResumeText}"
                         ToolTip.Tip="{Binding ResumeText}"
                         IsVisible="{Binding IsRefreshPaused}" />
        <atom:TextBlock Grid.Column="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <atom:TextBlock Grid.Column="3"
                   Text="{Binding SelectedCountText}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.RowSpan="3"
            Classes="dialogMask"
            IsVisible="{Binding IsEndProcessConfirmationVisible}">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Classes="dialogCard"
              Background="{DynamicResource PanelBackgroundBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="18">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="12">
            <Border Classes="dialogIcon">
              <atom:TextBlock Text="!"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource WarningBrush}" />
            </Border>
            <atom:TextBlock Grid.Column="1"
                       Text="{Binding EndProcessConfirmationTitleText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center" />
          </Grid>
          <atom:TextBlock Grid.Row="1"
                     Text="{Binding EndProcessConfirmationMessageText}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <Border Grid.Row="2"
                  Background="{DynamicResource PanelAltBackgroundBrush}"
                  BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="0"
                  MinHeight="150"
                  MaxHeight="300">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding PendingTerminationCandidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProcessTerminationCandidateViewModel"
                                x:CompileBindings="False">
                    <Border Padding="12,10"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                      <Grid RowDefinitions="Auto,Auto"
                            RowSpacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                          <Border CornerRadius="4"
                                  Padding="6,2"
                                  Background="{DynamicResource PanelAltBackgroundBrush}"
                                  BorderBrush="{DynamicResource PanelBorderBrush}"
                                  BorderThickness="1">
                            <atom:TextBlock Text="{Binding RelationText}"
                                            FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextBrush}" />
                          </Border>
                          <atom:CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Width="18"
                                         Height="18"
                                         MinWidth="18"
                                         VerticalAlignment="Center" />
                          <SelectableTextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                          <atom:TextBlock Text="{Binding PidText}"
                                          Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <SelectableTextBlock Grid.Row="1"
                                             Text="{Binding ExecutablePathText}"
                                             FontSize="11"
                                             TextWrapping="NoWrap"
                                             Foreground="{DynamicResource SecondaryTextBrush}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <StackPanel Grid.Row="3"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <atom:Button Content="{Binding CancelText}"
                         Command="{Binding CancelPendingProcessTermination}" />
            <atom:Button Content="{Binding ConfirmText}"
                         ButtonType="Primary"
                         IsDanger="True"
                         IsEnabled="{Binding HasSelectedPendingTerminationProcesses}"
                         Command="{Binding ConfirmPendingProcessTermination}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</atom:Window>
