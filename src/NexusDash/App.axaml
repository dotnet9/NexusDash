<prism:PrismApplication xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:codewf="https://codewf.com"
                         xmlns:markdownThemes="using:CodeWF.Markdown.Lite.Themes"
                         xmlns:prism="http://prismlibrary.com/"
                         xmlns:semi="https://irihi.tech/semi"
                         xmlns:themes="using:NexusDash.Controls.Themes"
                         x:Class="NexusDash.App"
                         Name="NexusDash"
                         RequestedThemeVariant="Dark">
  <prism:PrismApplication.Styles>
    <FluentTheme />
    <semi:SemiTheme />
    <semi:UrsaSemiTheme />
    <codewf:ACSemiTheme />
    <codewf:DataGridSemiTheme />
    <themes:NexusDashControlsThemes />
    <StyleInclude Source="Styles/AppStyles.axaml" />
    <markdownThemes:MarkdownThemes />
  </prism:PrismApplication.Styles>
</prism:PrismApplication>
