<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:codewf="https://codewf.com">
  <Styles.Resources>
    <x:Double x:Key="NexusDashAppFontSize">12</x:Double>
    <x:Double x:Key="NexusDashDataGridCellFontSize">11</x:Double>
    <x:Double x:Key="NexusDashDataGridHeaderFontSize">12</x:Double>
    <x:Double x:Key="NexusDashDataGridRowHeight">30</x:Double>
    <x:Double x:Key="NexusDashDataGridHeaderHeight">32</x:Double>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontSize" Value="{DynamicResource NexusDashAppFontSize}" />
  </Style>

  <Style Selector="codewf|CodeWFWindow">
    <Setter Property="TitleBarBackground" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="TitleBarBorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="TitleBarForeground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="codewf|CodeWFWindow.mainShell">
    <Setter Property="TitleBarHeight" Value="40" />
  </Style>

  <Style Selector="Window.mainShell">
    <Setter Property="Width" Value="1440" />
    <Setter Property="Height" Value="760" />
    <Setter Property="MinWidth" Value="1180" />
    <Setter Property="MinHeight" Value="620" />
  </Style>

  <Style Selector="codewf|CodeWFWindow.settingsShell">
    <Setter Property="TitleBarHeight" Value="38" />
  </Style>

  <Style Selector="Window.settingsShell">
    <Setter Property="Width" Value="600" />
    <Setter Property="Height" Value="427" />
    <Setter Property="MinWidth" Value="560" />
    <Setter Property="MinHeight" Value="400" />
  </Style>

  <Style Selector="TextBox.titleBarSearch">
    <Setter Property="Width" Value="520" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
  </Style>

  <Style Selector="TabItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="DataGrid.compactDataGrid">
    <Setter Property="FontSize" Value="{DynamicResource NexusDashDataGridCellFontSize}" />
    <Setter Property="RowHeight" Value="{DynamicResource NexusDashDataGridRowHeight}" />
    <Setter Property="ColumnHeaderHeight" Value="{DynamicResource NexusDashDataGridHeaderHeight}" />
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
  </Style>

  <Style Selector="DataGrid.compactDataGrid TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource NexusDashDataGridCellFontSize}" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="DataGrid.compactDataGrid DataGridColumnHeader">
    <Setter Property="FontSize" Value="{DynamicResource NexusDashDataGridHeaderFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
  </Style>

  <Style Selector="DataGrid.compactDataGrid DataGridColumnHeader TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource NexusDashDataGridHeaderFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="0 6 18 0 #12000000" />
  </Style>

  <Style Selector="Border.toolSidebar">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Border.logViewerPanel">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="Border.logViewerHeader">
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.logViewerContent">
    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <Style Selector="ListBox.toolNavMenu">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.toolNavMenu ListBoxItem">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.toolNavMenu ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.toolNavMenu ListBoxItem /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.toolNavMenu ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>

  <Style Selector="ListBox.toolNavMenu ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>

  <Style Selector="ListBox.toolNavMenu ListBoxItem:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.toolNavMenu ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
  </Style>

  <Style Selector="ListBox.toolNavMenu ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
  </Style>

  <Style Selector="ListBox.toolNavMenu ListBoxItem:selected /template/ Border">
    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.toolNavMenu TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="PathIcon.toolNavIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.metricPanel">
    <Setter Property="MinHeight" Value="116" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.metricBadge">
    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="Border.hardwareSection">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.dialogMask">
    <Setter Property="Background" Value="{DynamicResource DialogMaskBrush}" />
  </Style>

  <Style Selector="Border.dialogCard">
    <Setter Property="Width" Value="760" />
    <Setter Property="MaxWidth" Value="760" />
    <Setter Property="MinHeight" Value="340" />
    <Setter Property="Padding" Value="22" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 22 48 0 #66000000" />
  </Style>

  <Style Selector="Border.dialogIcon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.metricLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.metricValue">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.columnHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.hardwareInfoName">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="SelectableTextBlock.hardwareInfoValue">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.metricHint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.processAccessBadge">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.processFilterChip">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="CheckBox.processFilterCheck">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="RadioButton.settingOption">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Border.settingsInlineSurface">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BoxShadow" Value="0 18 42 0 #22000000" />
  </Style>

  <Style Selector="ListBox.settingsNav">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="Padding" Value="12,14" />
  </Style>

  <Style Selector="ListBox.settingsNav ListBoxItem">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.settingsNav ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.settingsNav ListBoxItem /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.settingsNav ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>

  <Style Selector="ListBox.settingsNav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>

  <Style Selector="ListBox.settingsNav ListBoxItem:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.settingsNav ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
  </Style>

  <Style Selector="ListBox.settingsNav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
  </Style>

  <Style Selector="ListBox.settingsNav ListBoxItem:selected /template/ Border">
    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.settingsNav TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="Border.settingsInlineSurface > Grid">
    <Setter Property="MinHeight" Value="430" />
  </Style>

  <Style Selector="TextBlock.settingsFormLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <Style Selector="ComboBox.settingSelector">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.themeSwatch">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.statusBarButton">
    <Setter Property="Width" Value="26" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MaxWidth" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="MaxHeight" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
  </Style>

  <Style Selector="Button.statusBarButton PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="Button.statusBarExportButton">
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="Border.titleBarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}" />
  </Style>

  <Style Selector="TextBlock.aboutLabel">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="Margin" Value="0,0,18,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="SelectableTextBlock.aboutValue">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.processCategoryIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="PathIcon.processCategoryIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="PathIcon.processExpanderIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
