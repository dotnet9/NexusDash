<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:codewf="https://codewf.com"
                     xmlns:prism="http://prismlibrary.com/"
                     xmlns:regions="using:NexusDash.Regions"
                     xmlns:vm="using:NexusDash.ViewModels.Settings"
                     mc:Ignorable="d"
                     d:DesignWidth="600"
                     d:DesignHeight="427"
                     x:Class="NexusDash.SettingsWindow"
                     x:DataType="vm:SettingsWindowViewModel"
                     prism:ViewModelLocator.AutoWireViewModel="True"
                     Classes="settingsShell"
                     Title="{Binding SettingsText}"
                     WindowStartupLocation="CenterOwner"
                     Icon="/Assets/logo.ico">

  <codewf:CodeWFWindow.LeftContent>
    <StackPanel Orientation="Horizontal"
                Spacing="8"
                Margin="8,0,10,0"
                VerticalAlignment="Center">
      <Image Source="/Assets/logo.png"
             Width="18"
             Height="18" />
      <TextBlock Text="{Binding SettingsText}"
                 FontSize="12"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </StackPanel>
  </codewf:CodeWFWindow.LeftContent>

  <TabControl x:Name="SettingsRegionTabs"
              Margin="14"
              TabStripPlacement="Left"
              Background="Transparent"
              prism:RegionManager.RegionName="{x:Static regions:RegionNames.SettingsRegion}" />
</codewf:CodeWFWindow>
