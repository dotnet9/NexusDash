<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:NexusDash.ViewModels"
             x:Class="NexusDash.Views.TitleBarSearchAddOn"
             x:DataType="vm:MainWindowViewModel"
             Height="38">

  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        Margin="12,0,128,0">
    <atom:LineEdit Classes="titleBarSearch"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   PlaceholderText="{Binding SearchPlaceholderText}"
                   InnerLeftContent="{antdicons:AntDesignIconProvider SearchOutlined}"
                   Text="{Binding SearchQuery, Mode=TwoWay}"
                   IsAllowClear="True"
                   StyleVariant="Filled" />
  </Grid>
</UserControl>
