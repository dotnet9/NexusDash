<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexusDash.ViewModels"
             x:Class="NexusDash.Views.TitleBarSearchAddOn"
             x:DataType="vm:MainWindowViewModel"
             Height="38">

  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        Margin="12,0,128,0">
    <TextBox x:Name="SearchLineEdit"
             Classes="titleBarSearch"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsVisible="{Binding IsSearchBoxVisible}"
             PlaceholderText="{Binding SearchPlaceholderText}"
             Text="{Binding SearchQuery, Mode=TwoWay}" />
  </Grid>
</UserControl>
