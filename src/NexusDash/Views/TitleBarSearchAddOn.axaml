<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexusDash.ViewModels"
             xmlns:settings="using:NexusDash.ViewModels.Settings"
             xmlns:codewf="https://codewf.com"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:l="using:NexusDash"
             x:Class="NexusDash.Views.TitleBarSearchAddOn"
             x:DataType="vm:MainWindowViewModel"
             Height="38">

  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Margin="12,0,8,0">
    <TextBox x:Name="SearchLineEdit"
             Classes="titleBarSearch"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsVisible="{Binding IsSearchBoxVisible}"
             PlaceholderText="{Binding SearchPlaceholderText}"
             Text="{Binding SearchQuery, Mode=TwoWay}" />
    <ListBox x:Name="TitleBarPalettes" ItemsSource="{Binding Appearance.PaletteOptions}" SelectedItem="{Binding Appearance.SelectedPalette}"
             Background="Transparent" BorderThickness="0" Padding="0" ToolTip.Tip="{Binding Appearance.PaletteLabel}">
      <ListBox.Styles><Style Selector="ListBoxItem">
        <Setter Property="Width" Value="24" /><Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4" /><Setter Property="CornerRadius" Value="15" />
      </Style></ListBox.Styles>
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate x:DataType="settings:ThemeOptionViewModel">
        <Ellipse Width="13" Height="13" Fill="{Binding AccentBrush}" ToolTip.Tip="{Binding DisplayName}" />
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <ThemeVariantScope x:Name="TitleBarThemeScope"
                       RequestedThemeVariant="{Binding Appearance.ThemeMode, Mode=TwoWay, Converter={x:Static codewf:StudioThemeModeConverter.Instance}}">
                <ThemeVariantScope.Resources>
                    <TextBlock x:Key="STRING_THEME_TOGGLE_SYSTEM" Text="{codewf:I18n {x:Static l:NexusDashL.ThemeSystem}}" />
                    <TextBlock x:Key="STRING_THEME_TOGGLE_LIGHT" Text="{codewf:I18n {x:Static l:NexusDashL.LightTheme}}" />
                    <TextBlock x:Key="STRING_THEME_TOGGLE_DARK" Text="{codewf:I18n {x:Static l:NexusDashL.DarkTheme}}" />
                </ThemeVariantScope.Resources>
      <u:ThemeToggleButton x:Name="TitleBarThemeToggle" Width="30" Height="30" IsThreeState="True"
                           TargetScope="{Binding #TitleBarThemeScope}" ToolTip.Tip="{Binding ThemeMenuText}" />
    </ThemeVariantScope>
    <ComboBox x:Name="TitleBarLanguageSelector" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
              Width="50" Height="30" MinHeight="0" Padding="6,0" HorizontalContentAlignment="Left" ToolTip.Tip="{Binding LanguageMenuText}">
      <ComboBox.SelectionBoxItemTemplate><DataTemplate><PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconLanguage}" /></DataTemplate></ComboBox.SelectionBoxItemTemplate>
      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LanguageOption"><TextBlock MinWidth="120" Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
  </StackPanel>
</UserControl>
