<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NexusDash.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="760"
             x:Class="NexusDash.Views.EndProcessConfirmationView"
             x:DataType="vm:EndProcessConfirmationViewModel">
  <Border Classes="dialogMask"
          IsVisible="{Binding IsEndProcessConfirmationVisible}">
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="dialogCard"
            Background="{DynamicResource PanelBackgroundBrush}">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto"
            RowSpacing="18">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="12">
          <Border Classes="dialogIcon">
            <TextBlock Text="!"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource WarningBrush}" />
          </Border>
          <TextBlock Grid.Column="1"
                          Text="{Binding EndProcessConfirmationTitleText}"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          VerticalAlignment="Center" />
        </Grid>
        <TextBlock Grid.Row="1"
                        Text="{Binding EndProcessConfirmationMessageText}"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource SecondaryTextBrush}" />
        <Border Grid.Row="2"
                Background="{DynamicResource PanelAltBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0"
                MinHeight="150"
                MaxHeight="300">
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PendingTerminationCandidates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProcessTerminationCandidateViewModel"
                              x:CompileBindings="False">
                  <Border Padding="12,10"
                          BorderBrush="{DynamicResource PanelBorderBrush}"
                          BorderThickness="0,0,0,1">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="6">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8">
                        <Border CornerRadius="4"
                                Padding="6,2"
                                Background="{DynamicResource PanelAltBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1">
                          <TextBlock Text="{Binding RelationText}"
                                          FontSize="11"
                                          Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                       Width="18"
                                       Height="18"
                                       MinWidth="18"
                                       VerticalAlignment="Center" />
                        <SelectableTextBlock Text="{Binding Name}"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding PidText}"
                                        Foreground="{DynamicResource SecondaryTextBrush}" />
                      </StackPanel>
                      <SelectableTextBlock Grid.Row="1"
                                           Text="{Binding ExecutablePathText}"
                                           FontSize="11"
                                           TextWrapping="NoWrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Button Content="{Binding CancelText}"
                       Command="{Binding CancelPendingProcessTerminationCommand}" />
          <Button Content="{Binding ConfirmText}"

                       IsEnabled="{Binding HasSelectedPendingTerminationProcesses}"
                       Command="{Binding ConfirmPendingProcessTerminationCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Border>
</UserControl>
