<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:NexusDash.Views"
             xmlns:vm="using:NexusDash.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1060"
             d:DesignHeight="560"
             x:Class="NexusDash.Views.ProcessExplorerView"
             x:DataType="vm:ProcessExplorerViewModel">
  <Grid Margin="0,12,0,0"
        ColumnDefinitions="*,5,360"
        ColumnSpacing="10">
    <views:ProcessListView Grid.Column="0"
                           DataContext="{Binding ProcessList}" />
    <GridSplitter Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource PanelBorderBrush}" />
    <views:ProcessInspectorView Grid.Column="2"
                                DataContext="{Binding Inspector}" />
  </Grid>
</UserControl>
