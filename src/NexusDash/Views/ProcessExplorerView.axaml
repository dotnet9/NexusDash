<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:atom="https://atomui.net"
             xmlns:ndc="https://nexusdash.net/controls"
             xmlns:views="using:NexusDash.Views"
             xmlns:vm="using:NexusDash.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1060"
             d:DesignHeight="560"
             x:Class="NexusDash.Views.ProcessExplorerView"
             x:DataType="vm:ProcessExplorerViewModel">
  <Grid Margin="0,12,0,0"
        RowDefinitions="*,188"
        RowSpacing="12">
    <views:ProcessListView Grid.Row="0"
                           DataContext="{Binding ProcessList}" />

    <Border Grid.Row="1"
            Classes="panel"
            Padding="12">
      <Grid RowDefinitions="Auto,*">
        <atom:TextBlock Text="{Binding TreemapText}"
                        Classes="sectionTitle"
                        FontWeight="SemiBold"
                        Margin="2,0,0,10" />
        <ndc:ProcessTreemapControl Grid.Row="1"
                                   Items="{Binding TreemapProcesses}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
