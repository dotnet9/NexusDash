<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:NexusDash.Views"
             xmlns:vm="using:NexusDash.ViewModels"
             xmlns:settingsVm="using:NexusDash.ViewModels.Settings"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="640"
             x:Class="NexusDash.Views.ToolContentView"
             x:DataType="vm:ToolContentViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ProcessManagerViewModel">
      <views:ProcessManagerView />
    </DataTemplate>
    <DataTemplate DataType="vm:FileSearchViewModel">
      <views:FileSearchView />
    </DataTemplate>
    <DataTemplate DataType="vm:HardwareInfoViewModel">
      <views:HardwareInfoView />
    </DataTemplate>
    <DataTemplate DataType="settingsVm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <ContentControl Content="{Binding ActiveTool}" />
</UserControl>
