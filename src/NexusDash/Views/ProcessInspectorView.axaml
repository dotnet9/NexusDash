<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:behaviors="using:NexusDash.Views.Behaviors"
             xmlns:models="using:NexusDash.Models"
             xmlns:vm="using:NexusDash.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1060"
             d:DesignHeight="560"
             x:Class="NexusDash.Views.ProcessInspectorView"
             x:DataType="vm:ProcessInspectorViewModel">
  <Border Classes="panel">
    <TabControl>
      <TabItem Header="{Binding DetailsText}">
        <Grid Margin="14">
          <TextBlock Text="{Binding NoProcessSelectedText}"
                          IsVisible="{Binding !HasSelectedProcess}"
                          Foreground="{DynamicResource SecondaryTextBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

          <ScrollViewer IsVisible="{Binding HasSelectedProcess}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding SelectedProcess.Name}"
                              FontSize="16"
                              FontWeight="SemiBold"
                              TextTrimming="CharacterEllipsis" />
              <Border IsVisible="{Binding HasSelectedProcessAccessLimit}"
                      Background="{DynamicResource PanelAltBackgroundBrush}"
                      BorderBrush="{DynamicResource WarningBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="10,8">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding AccessLimitedText}"
                                  Foreground="{DynamicResource WarningBrush}"
                                  FontWeight="SemiBold" />
                  <TextBlock Text="{Binding AccessLimitedDescriptionText}"
                                  TextWrapping="Wrap"
                                  Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,*"
                    ColumnSpacing="8">
                <Border Classes="metricBadge">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding CpuText}"
                               Classes="metricLabel" />
                    <TextBlock Text="{Binding SelectedProcess.CpuText}"
                               Classes="metricValue" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Classes="metricBadge">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding MemoryText}"
                               Classes="metricLabel" />
                    <TextBlock Text="{Binding SelectedProcess.MemoryText}"
                               Classes="metricValue" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Classes="hardwareInfoItem">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="8">
                  <Grid ColumnDefinitions="104,*">
                    <TextBlock Text="{Binding PidText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedProcess.Pid}" />
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="104,*">
                    <TextBlock Text="{Binding PublisherText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedProcess.PublisherText}" TextWrapping="Wrap" />
                  </Grid>
                  <Grid Grid.Row="2" ColumnDefinitions="104,*">
                    <TextBlock Text="{Binding StartTimeText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedProcess.StartTimeText}" TextWrapping="Wrap" />
                  </Grid>
                  <Grid Grid.Row="3" ColumnDefinitions="104,*">
                    <TextBlock Text="{Binding PathText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedProcess.ExecutablePath}"
                               TextWrapping="Wrap" />
                  </Grid>
                </Grid>
              </Border>

              <Grid RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding CommandLineText}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Margin="0,4,0,6" />
                <TextBox Grid.Row="1"
                              Height="132"
                              Text="{Binding SelectedProcess.CommandLine}"
                              IsReadOnly="True"
                              AcceptsReturn="True"
                              TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding HandlesText}">
        <Grid Margin="14" RowDefinitions="Auto,*" RowSpacing="12">
          <TextBox PlaceholderText="{Binding HandlesSearchPlaceholderText}" />

          <TextBlock Grid.Row="1"
                          Text="{Binding HandlesUnavailableText}"
                          TextWrapping="Wrap"
                          Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>
      </TabItem>

      <TabItem Header="{Binding NetworkText}">
        <Grid Margin="12"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="12">
          <Grid ColumnDefinitions="*,92"
                ColumnSpacing="8">
            <StackPanel Spacing="3"
                        VerticalAlignment="Center">
              <TextBlock Classes="sectionTitle"
                              Text="{Binding ProcessNetworkConnectionsText}"
                              Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Classes="muted"
                              Text="{Binding SelectedProcessNetworkSummaryText}"
                              FontSize="11"
                              Foreground="{DynamicResource SecondaryTextBrush}"
                              TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1"
                    Classes="metricBadge"
                    MinWidth="86">
              <TextBlock Text="{Binding SelectedProcessConnectionTotalText}"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              HorizontalAlignment="Center"
                              TextTrimming="CharacterEllipsis" />
            </Border>
          </Grid>

          <Grid Grid.Row="1"
                ColumnDefinitions="*,*"
                ColumnSpacing="8">
            <Border Grid.Column="0"
                    Classes="metricBadge">
              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="8">
                <Border Width="8"
                        Height="8"
                        CornerRadius="4"
                        Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                                Text="{Binding SelectedProcessTcpConnectionCountText}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
            <Border Grid.Column="1"
                    Classes="metricBadge">
              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="8">
                <Border Width="8"
                        Height="8"
                        CornerRadius="4"
                        Background="{DynamicResource SuccessBrush}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                                Text="{Binding SelectedProcessUdpConnectionCountText}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
          </Grid>

          <Grid Grid.Row="2">
            <TextBlock Text="{Binding NetworkSelectProcessText}"
                            IsVisible="{Binding !HasSelectedProcess}"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

            <TextBlock Text="{Binding NetworkNoConnectionsText}"
                            IsVisible="{Binding HasSelectedProcessWithoutNetworkConnections}"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

            <DataGrid x:Name="NetworkConnectionsGrid"
                           ItemsSource="{Binding SelectedProcessNetworkConnections}"
                           Classes="compactDataGrid"
                           AutoGenerateColumns="False"
                           CanUserReorderColumns="True"
                           CanUserResizeColumns="True"
                           CanUserSortColumns="True"
                           IsReadOnly="True"

                           IsVisible="{Binding HasSelectedProcessNetworkConnections}"

                           GridLinesVisibility="Horizontal"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"
                           Background="Transparent">
              <i:Interaction.Behaviors>
                <behaviors:NetworkConnectionMenuBehavior />
              </i:Interaction.Behaviors>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="{Binding ProtocolText}"
                                             Width="72"
                                             SortMemberPath="Protocol"
                                             CanUserSort="True"
                                             CanUserResize="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                      <TextBlock Text="{Binding Protocol}"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding LocalEndpointText}"
                                             Width="150"
                                             SortMemberPath="LocalEndpointText"
                                             CanUserSort="True"
                                             CanUserResize="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                      <TextBlock Text="{Binding LocalEndpointText}"
                                      TextTrimming="CharacterEllipsis"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding RemoteEndpointText}"
                                             Width="150"
                                             SortMemberPath="RemoteEndpointText"
                                             CanUserSort="True"
                                             CanUserResize="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                      <TextBlock Text="{Binding RemoteEndpointText}"
                                      TextTrimming="CharacterEllipsis"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding StateText}"
                                             Width="92"
                                             SortMemberPath="State"
                                             CanUserSort="True"
                                             CanUserResize="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                      <TextBlock Text="{Binding State}"
                                      TextTrimming="CharacterEllipsis"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource SecondaryTextBrush}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding LastSeenText}"
                                             Width="118"
                                             SortMemberPath="Timestamp"
                                             CanUserSort="True"
                                             CanUserResize="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="models:ProcessNetworkConnection" x:CompileBindings="False">
                      <TextBlock Text="{Binding TimestampText}"
                                      TextTrimming="CharacterEllipsis"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource SecondaryTextBrush}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding ServicesText}">
        <TextBlock Margin="14"
                        Text="{Binding ServicesUnavailableText}"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource SecondaryTextBrush}" />
      </TabItem>

      <TabItem Header="{Binding StartupText}">
        <TextBlock Margin="14"
                        Text="{Binding StartupUnavailableText}"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource SecondaryTextBrush}" />
      </TabItem>
    </TabControl>
  </Border>
</UserControl>
