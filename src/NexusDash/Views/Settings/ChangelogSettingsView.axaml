<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:atom="https://atomui.net"
             xmlns:codewf="https://codewf.com"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="using:NexusDash.ViewModels.Settings"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignWidth="540"
             d:DesignHeight="420"
             x:Class="NexusDash.Views.Settings.ChangelogSettingsView"
             x:DataType="vm:ChangelogSettingsViewModel">
  <UserControl.Styles>
    <Style Selector="codewf|MarkdownViewer.changelogMarkdown">
      <Setter Property="TextBrush" Value="#1F2328" />
      <Setter Property="MutedTextBrush" Value="#667085" />
      <Setter Property="BorderLineBrush" Value="#D0D7DE" />
      <Setter Property="AccentBrush" Value="#4B5563" />
      <Setter Property="QuoteBackgroundBrush" Value="#F6F7F9" />
      <Setter Property="CodeBackgroundBrush" Value="#F6F8FA" />
      <Setter Property="InlineCodeBackgroundBrush" Value="#F6F7F9" />
      <Setter Property="TableHeaderBackgroundBrush" Value="#EAECF0" />
      <Setter Property="AccentForegroundBrush" Value="#FFFFFF" />
    </Style>

    <Style Selector="atom|Window.dark codewf|MarkdownViewer.changelogMarkdown">
      <Setter Property="TextBrush" Value="#E6EDF3" />
      <Setter Property="MutedTextBrush" Value="#9BA7B4" />
      <Setter Property="BorderLineBrush" Value="#30363D" />
      <Setter Property="AccentBrush" Value="#D1D5DB" />
      <Setter Property="QuoteBackgroundBrush" Value="#252933" />
      <Setter Property="CodeBackgroundBrush" Value="#0D1117" />
      <Setter Property="InlineCodeBackgroundBrush" Value="#252933" />
      <Setter Property="TableHeaderBackgroundBrush" Value="#303643" />
      <Setter Property="AccentForegroundBrush" Value="#0D1117" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="4,6,18,18"
        RowDefinitions="Auto,*"
        RowSpacing="12">
    <StackPanel Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right">
      <atom:Button Content="{Binding ChineseText}"
                   MinWidth="88"
                   Height="30"
                   Padding="12,4"
                   Command="{Binding LoadChinese}" />
      <atom:Button Content="{Binding EnglishText}"
                   MinWidth="88"
                   Height="30"
                   Padding="12,4"
                   Command="{Binding LoadEnglish}" />
    </StackPanel>

    <Border Grid.Row="1"
            Background="{DynamicResource PanelAltBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <codewf:MarkdownViewer Classes="changelogMarkdown"
                               Markdown="{Binding Markdown}"
                               TypographyTheme="{x:Static codewf:MarkdownTypographyThemes.Simple}"
                               TypographySize="{x:Static codewf:MarkdownTypographySizes.Small}" />
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
