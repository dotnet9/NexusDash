<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="using:NexusDash.ViewModels.Settings"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignWidth="540"
             d:DesignHeight="420"
             x:Class="NexusDash.Views.Settings.AppearanceSettingsView"
             x:DataType="vm:AppearanceSettingsViewModel">
  <Grid Margin="4,6,18,18"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="18">
    <Grid ColumnDefinitions="86,*"
          ColumnSpacing="18">
      <TextBlock Text="{Binding ThemeLabel}"
                      FontWeight="SemiBold"
                      VerticalAlignment="Center" />
      <Grid Grid.Column="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="10">
        <RadioButton Classes="settingOption"
                          GroupName="SettingsTheme"
                          Command="{Binding SetLightTheme}"
                          IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                          Content="{Binding LightThemeText}" />
        <RadioButton Grid.Column="1"
                          Classes="settingOption"
                          GroupName="SettingsTheme"
                          Command="{Binding SetDarkTheme}"
                          IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                          Content="{Binding DarkThemeText}" />
      </Grid>
    </Grid>

    <Grid Grid.Row="1"
          ColumnDefinitions="86,*"
          ColumnSpacing="18">
      <TextBlock Text="{Binding LanguageLabel}"
                      FontWeight="SemiBold"
                      VerticalAlignment="Top"
                      Margin="0,3,0,0" />
      <Grid Grid.Column="1"
            ColumnDefinitions="*,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="6">
        <RadioButton Classes="settingOption"
                          GroupName="SettingsLanguage"
                          Command="{Binding SelectSimplifiedChinese}"
                          IsChecked="{Binding IsSimplifiedChinese, Mode=OneWay}"
                          Content="{Binding SimplifiedChineseText}" />
        <RadioButton Grid.Column="1"
                          Classes="settingOption"
                          GroupName="SettingsLanguage"
                          Command="{Binding SelectTraditionalChinese}"
                          IsChecked="{Binding IsTraditionalChinese, Mode=OneWay}"
                          Content="{Binding TraditionalChineseText}" />
        <RadioButton Grid.Row="1"
                          Classes="settingOption"
                          GroupName="SettingsLanguage"
                          Command="{Binding SelectEnglish}"
                          IsChecked="{Binding IsEnglish, Mode=OneWay}"
                          Content="{Binding EnglishText}" />
        <RadioButton Grid.Row="1"
                          Grid.Column="1"
                          Classes="settingOption"
                          GroupName="SettingsLanguage"
                          Command="{Binding SelectJapanese}"
                          IsChecked="{Binding IsJapanese, Mode=OneWay}"
                          Content="{Binding JapaneseText}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
