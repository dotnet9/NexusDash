<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:NexusDash.ViewModels.Settings"
             mc:Ignorable="d"
             d:DesignWidth="540"
             d:DesignHeight="420"
             x:Class="NexusDash.Views.Settings.ProcessSettingsView"
             x:DataType="vm:ProcessSettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.settingRow">
      <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="4,6,18,18"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="12">
    <Border Classes="settingRow">
      <StackPanel Spacing="4">
        <atom:TextBlock Text="{Binding ProcessGroupingLabel}"
                        FontWeight="SemiBold" />
        <atom:TextBlock Text="{Binding ProcessGroupingValue}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Classes="settingRow">
      <StackPanel Spacing="4">
        <atom:TextBlock Text="{Binding ProcessIconsLabel}"
                        FontWeight="SemiBold" />
        <atom:TextBlock Text="{Binding ProcessIconsValue}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            Classes="settingRow">
      <StackPanel Spacing="4">
        <atom:TextBlock Text="{Binding ColumnPersistenceLabel}"
                        FontWeight="SemiBold" />
        <atom:TextBlock Text="{Binding ColumnPersistenceValue}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
