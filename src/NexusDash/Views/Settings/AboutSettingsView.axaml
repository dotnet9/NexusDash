<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:atom="https://atomui.net"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="using:NexusDash.ViewModels.Settings"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignWidth="540"
             d:DesignHeight="420"
             x:Class="NexusDash.Views.Settings.AboutSettingsView"
             x:DataType="vm:AboutSettingsViewModel">
  <ScrollViewer Margin="4,6,18,18"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="42,*"
            ColumnSpacing="14">
        <Image Source="/Assets/logo.png"
               Width="34"
               Height="34"
               Stretch="Uniform"
               HorizontalAlignment="Left"
               VerticalAlignment="Center" />
        <StackPanel Grid.Column="1"
                    Spacing="3"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding AppName}"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding Description}"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="110,*"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="9">
        <TextBlock Text="{Binding VersionLabel}"
                   Classes="aboutLabel" />
        <SelectableTextBlock Grid.Column="1"
                             Text="{Binding Version}"
                             Classes="aboutValue" />

        <TextBlock Grid.Row="1"
                   Text="{Binding CompileTimeLabel}"
                   Classes="aboutLabel" />
        <SelectableTextBlock Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding CompileTime}"
                             Classes="aboutValue" />

        <TextBlock Grid.Row="2"
                   Text="{Binding AuthorLabel}"
                   Classes="aboutLabel" />
        <SelectableTextBlock Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding Author}"
                             Classes="aboutValue" />

        <TextBlock Grid.Row="3"
                   Text="{Binding RepositoryLabel}"
                   Classes="aboutLabel" />
        <atom:HyperLinkButton Grid.Row="3"
                              Grid.Column="1"
                              NavigateUri="{Binding RepositoryUri}"
                              Padding="0"
                              HorizontalAlignment="Left"
                              HorizontalContentAlignment="Left"
                              VerticalAlignment="Center">
          <TextBlock Text="{Binding RepositoryUrl}"
                     TextWrapping="Wrap" />
        </atom:HyperLinkButton>

        <TextBlock Grid.Row="4"
                   Text="{Binding LicenseLabel}"
                   Classes="aboutLabel" />
        <SelectableTextBlock Grid.Row="4"
                             Grid.Column="1"
                             Text="{Binding License}"
                             Classes="aboutValue" />

        <TextBlock Grid.Row="5"
                   Text="{Binding CopyrightLabel}"
                   Classes="aboutLabel" />
        <SelectableTextBlock Grid.Row="5"
                             Grid.Column="1"
                             Text="{Binding Copyright}"
                             Classes="aboutValue" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
